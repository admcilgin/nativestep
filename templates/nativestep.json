{
  "protocol": 1,
  "kits": "0.1.0",
  "app": {
    "name": "__APP_NAME__",
    "iosBundleId": "__IOS_BUNDLE_ID__",
    "androidPackage": "__ANDROID_PACKAGE__"
  },
  "paths": {
    "tests": "spec/tests",
    "fixtures": "spec/fixtures"
  },
  "targets": {
    "ios": {
      "build": "swift build --package-path ios/Core --product nativestep-host",
      "headless": "ios/Core/.build/debug/nativestep-host",
      "device": {
        "build": "cd ios && xcodegen generate --quiet && xcodebuild -project __APP_NAME__.xcodeproj -scheme __APP_NAME__ -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath build -quiet build && xcrun simctl install booted build/Build/Products/Debug-iphonesimulator/__APP_NAME__.app",
        "setup": "xcrun simctl launch --terminate-running-process booted __IOS_BUNDLE_ID__",
        "connect": "tcp://127.0.0.1:7358",
        "screenshot": "xcrun simctl io booted screenshot {out}"
      }
    },
    "android": {
      "build": "android/gradlew -p android -q :host:installDist",
      "headless": "android/host/build/install/host/bin/host",
      "device": {
        "build": "android/gradlew -p android -q :app:installDebug",
        "setup": "adb forward tcp:7359 tcp:7359 && adb shell am start -S -W -n __ANDROID_PACKAGE__/.MainActivity",
        "connect": "tcp://127.0.0.1:7359",
        "screenshot": "adb exec-out screencap -p > {out}"
      }
    }
  }
}
